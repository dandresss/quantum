# Copy to .env for local development. On Vercel, the Neon/Postgres integration
# injects DATABASE_URL automatically (use the pooled connection string).
DATABASE_URL=postgresql://quantum:quantum@localhost:5432/quantum

# Only used by the test suite; points at a throwaway database (it gets truncated).
TEST_DATABASE_URL=postgresql://quantum:quantum@localhost:5432/quantum_test

MAX_QUBITS=12
MAX_SHOTS=10000
